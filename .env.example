DATABASE_URL=
# Required for NextAuth (same value can be used for both).
AUTH_SECRET=
# NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Vercel Blob (REQUIRED in production for resume uploads).
# Create a Blob store: Vercel Dashboard → your project → Storage → Create → Database → Blob.
# Vercel injects BLOB_READ_WRITE_TOKEN (and BLOB_STORE_ID) automatically into the
# deployed environment once the store is connected to the project.
# For LOCAL development, copy the token from the Vercel dashboard into your .env.
BLOB_READ_WRITE_TOKEN=

# Google OAuth (for "Continue with Google" on the login & register pages).
# Create a Google Cloud OAuth 2.0 Client ID at https://console.cloud.google.com
# Authorized JavaScript origins: <your-origin> + your production URL
# Authorized redirect URI:  <your-origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
